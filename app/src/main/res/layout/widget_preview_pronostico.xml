<?xml version="1.0" encoding="utf-8"?>
<!-- Como el Pronóstico: encabezado de Clima arriba y los días abajo, con máxima y mínima en una línea. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Córdoba"
            android:textColor="@color/preview_text_variant"
            android:textSize="13sp" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="@color/preview_text"
            android:textSize="36sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_clear_day" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Despejado"
            android:textColor="@color/preview_text"
            android:textSize="13sp" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máx 26°  Mín 13°"
            android:textColor="@color/preview_text"
            android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Hoy"
            android:textColor="@color/preview_text_variant"
            android:textSize="12sp" />

            <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginVertical="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_clear_day" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26° 13°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mañana"
            android:textColor="@color/preview_text_variant"
            android:textSize="12sp" />

            <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginVertical="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_partly_cloudy_day" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23° 12°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Lun"
            android:textColor="@color/preview_text_variant"
            android:textSize="12sp" />

            <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginVertical="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_rain" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19° 10°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mar"
            android:textColor="@color/preview_text_variant"
            android:textSize="12sp" />

            <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginVertical="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_cloudy" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21° 11°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
