<?xml version="1.0" encoding="utf-8"?>
<!-- Como Semana: encabezado de Clima y los días con mínima, barra y máxima. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Córdoba"
            android:textColor="@color/preview_text_variant"
            android:textSize="13sp" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="@color/preview_text"
            android:textSize="36sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_clear_day" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Despejado"
            android:textColor="@color/preview_text"
            android:textSize="13sp" />

            <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máx 26°  Mín 13°"
            android:textColor="@color/preview_text"
            android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Hoy"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_clear_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="13°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@color/preview_chip"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:background="@color/preview_line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.15" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="26°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mañana"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_partly_cloudy_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@color/preview_chip"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.25" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.45"
                android:background="@color/preview_line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="23°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Lun"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_rain" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="10°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@color/preview_chip"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.0" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:background="@color/preview_line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="19°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mar"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_cloudy" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="11°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@color/preview_chip"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:background="@color/preview_line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="21°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Mié"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_clear_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@color/preview_chip"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.2" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:background="@color/preview_line" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="24°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
