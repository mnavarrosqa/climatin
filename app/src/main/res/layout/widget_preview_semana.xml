<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Córdoba"
        android:textColor="@color/preview_text_variant"
        android:textSize="12sp" />

            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24°"
        android:textColor="@color/preview_text"
        android:textSize="26sp" />
        </LinearLayout>

        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_clear_day" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoy"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_clear_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="26°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="13°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mañana"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_partly_cloudy_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="23°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lun"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_rain" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="19°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="10°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mar"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_cloudy" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="21°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="11°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mié"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_clear_day" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="24°"
            android:textColor="@color/preview_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12°"
            android:textColor="@color/preview_text_variant"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
