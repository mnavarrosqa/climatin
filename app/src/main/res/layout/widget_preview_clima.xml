<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
        android:id="@+id/preview_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Córdoba"
        android:textColor="@color/preview_text_variant"
        android:textSize="13sp" />

        <TextView
        android:id="@+id/preview_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="22°"
        android:textColor="@color/preview_text"
        android:textSize="44sp" />

        <TextView
        android:id="@+id/preview_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parcialmente nublado"
        android:textColor="@color/preview_text"
        android:textSize="14sp" />

        <TextView
        android:id="@+id/preview_minmax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Máx 25° · Mín 14°"
        android:textColor="@color/preview_text_variant"
        android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/preview_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_partly_cloudy_day" />
</LinearLayout>
