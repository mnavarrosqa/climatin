<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad y pase a un teléfono nuevo (Android 12+): lo mismo que backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pronosticos/" />
        <exclude domain="file" path="ultimo_error.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pronosticos/" />
        <exclude domain="file" path="ultimo_error.txt" />
    </device-transfer>
</data-extraction-rules>
