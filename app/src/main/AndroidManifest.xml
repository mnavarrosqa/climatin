<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <application
        android:name=".ClimaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clima">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ClimaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_clima_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clima_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PronosticoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pronostico_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pronostico_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.VistazoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_vistazo_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vistazo_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.GraficoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_grafico_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grafico_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BurbujaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_burbuja_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burbuja_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PildoraWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_pildora_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pildora_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SemanaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_semana_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/semana_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SolWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_sol_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sol_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ProximaHoraWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_proxima_hora_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/proxima_hora_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CiudadesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ciudades_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ciudades_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.IndicadorWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_indicador_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/indicador_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".wallpaper.SkyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/sky_wallpaper" />
        </service>

        <service
            android:name=".tile.ClimaTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_weather"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
